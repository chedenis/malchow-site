{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/q/:id", "destination": "/q" }],
  "redirects": [
    { "source": "/seasonal-care-plan", "destination": "/plan", "permanent": true },
    { "source": "/referral", "destination": "/branch-out", "permanent": true }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/config.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
